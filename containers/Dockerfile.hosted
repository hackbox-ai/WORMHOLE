# ──────────────────────────────────────────────────────────────
# 虫洞 Wormhole — 托管模式镜像（单容器，agent + claude 同进程空间）
#
# 基于 wormhole-solver:latest（已含 Kali 全套工具 + claude CLI + PWN 工具），
# 叠加 wormhole Python 包 + skills + 托管 entrypoint。
#
# 构建（从 src/ 目录执行）：
#   docker build -f containers/Dockerfile.hosted -t wormhole-hosted:latest .
#
# 本地测试：
#   docker run --rm \
#     -e BENCHMARK_TOKEN=test -e BENCHMARK_BASE_URL=https://... \
#     -e ANTHROPIC_AUTH_TOKEN=sk-... -e ANTHROPIC_BASE_URL=https://api.deepseek.com \
#     -e ANTHROPIC_MODEL=deepseek-v4-pro \
#     wormhole-hosted:latest
#
# 导出上传（平台要求 .tar.gz，<3GB）：
#   docker save wormhole-hosted:latest | gzip > wormhole-hosted.tar.gz
# ──────────────────────────────────────────────────────────────

FROM wormhole-solver:latest

USER root

# ── 安装 wormhole solver 的 Python 依赖 ──
# solver 路径只需 requests（benchmark_client HTTP 调用）+ 标准库。
# 不装 fastapi/uvicorn（那是 webui 用的，托管模式跑 CLI）。
# 不装 openai-agents/docker/networkx 等（那是 GUI 路径的依赖）。
RUN pip3 install --no-cache-dir --break-system-packages requests

# ── 复制 wormhole solver 源码 ──
# COPY 的源路径相对于 build context（src/ 目录）
# 包含 solver/ 下的所有代码 + prompts/ 模板 + skills/
COPY wormhole/ /app/wormhole/
ENV PYTHONPATH="/app:${PYTHONPATH}"

# ── 复制 skills 到 claude 的发现路径（托管模式没有宿主机 bind-mount）──
# claude CLI 自动发现 /home/kali/workspace/.claude/skills/ 下的 SKILL.md
# 基础镜像已有内置 .claude/，这里叠加虫洞自己的 skills（ctf-solve-strategy 等）
COPY wormhole/solver/skills/ /home/kali/workspace/.claude/skills/

# ── 复制 entrypoint ──
COPY containers/entrypoint-hosted.sh /usr/local/bin/entrypoint-hosted.sh
RUN chmod +x /usr/local/bin/entrypoint-hosted.sh

# ── 清理不需要的大目录以控制在 3GB 上传限制内 ──
# PoC 仓库 (2.1GB) — 虫洞有 nuclei 模板 + 内置 skill 覆盖，不需要原始 PoC clone
RUN rm -rf /home/kali/pocs/
# 知识库仓库 (387MB) — skill 已蒸馏 hacktricks/PayloadsAllTheThings 精华
RUN rm -rf /home/kali/knowledges/
# 清理构建缓存
RUN apt-get clean && pip3 cache purge 2>/dev/null; rm -rf /tmp/* /var/tmp/* /root/.cache /home/kali/.cache

USER kali
WORKDIR /home/kali/workspace

ENTRYPOINT ["entrypoint-hosted.sh"]
