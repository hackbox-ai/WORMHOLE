# ──────────────────────────────────────────────────────────────
# 虫洞 Wormhole — 托管模式精简镜像
#
# 基于 kalilinux/kali-rolling 只装核心工具，控制在 3GB 以内。
# 工具清单来自实际 63 题任务日志分析（工具使用频次）。
#
# 构建（从 src/ 目录）：
#   docker build -f containers/Dockerfile.slim -t wormhole-hosted:slim .
# 导出：
#   docker save wormhole-hosted:slim | gzip > wormhole-hosted.tar.gz
# ──────────────────────────────────────────────────────────────

FROM kalilinux/kali-rolling:latest

USER root

# ── 基础系统工具 + 核心渗透工具（一次 apt 减少层数）──
RUN apt-get update && apt-get install -y --no-install-recommends \
        # 基础
        curl wget git jq openssl ca-certificates file xxd netcat-openbsd \
        sshpass unzip zip bzip2 gzip tar coreutils procps iproute2 dnsutils \
        # 侦察 / Web
        nmap masscan whatweb nikto dirsearch gobuster ffuf feroxbuster \
        wpscan nuclei sqlmap \
        # 二进制 / PWN
        gdb gdbserver strace ltrace binutils elfutils file checksec patchelf cmake \
        # 数据库客户端
        redis-tools default-mysql-client \
        # 云工具
        awscli \
        # Python
        python3 python3-pip python3-venv python3-dev \
        # Node.js (claude code CLI 依赖)
        nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# ── Python 渗透库 ──
RUN pip3 install --no-cache-dir --break-system-packages \
        requests pwntools ROPgadget checksec.py angr \
    && gem install one_gadget 2>/dev/null || true

# ── nuclei 模板 ──
RUN nuclei -update-templates 2>/dev/null || true

# ── claude code CLI ──
RUN npm install -g @anthropic-ai/claude-code@2.1.98

# ── jwt_tool ──
RUN pip3 install --no-cache-dir --break-system-packages jwt-tool 2>/dev/null || \
    git clone --depth 1 https://github.com/ticarpi/jwt_tool /opt/jwt_tool && \
    pip3 install --no-cache-dir --break-system-packages -r /opt/jwt_tool/requirements.txt 2>/dev/null || true

# ── chisel（内网穿透）──
RUN apt-get update && apt-get install -y --no-install-recommends chisel.common-binaries 2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/*

# ── 创建工作用户 ──
RUN useradd -m -s /bin/bash -u 1000 kali 2>/dev/null || true
ENV PATH="/home/kali/.local/bin:/usr/local/bin:${PATH}"

# ── 虫洞编排代码 ──
COPY wormhole/ /app/wormhole/
ENV PYTHONPATH="/app"

# ── 虫洞 CTF Skill（8 个文件, 1853 行方法论）──
COPY wormhole/solver/skills/ /home/kali/workspace/.claude/skills/

# ── CLAUDE.md 工作配置 ──
RUN mkdir -p /home/kali/workspace/.claude && \
    echo 'You are an autonomous penetration testing agent. Use available tools freely.' > /home/kali/workspace/CLAUDE.md

# ── entrypoint ──
COPY containers/entrypoint-hosted.sh /usr/local/bin/entrypoint-hosted.sh
RUN chmod +x /usr/local/bin/entrypoint-hosted.sh

# ── 最终清理 ──
# python → python3 符号链接：claude CLI / skill 脚本可能调用裸 python
RUN ln -sf /usr/bin/python3 /usr/local/bin/python && \
    apt-get clean && pip3 cache purge 2>/dev/null; \
    rm -rf /tmp/* /var/tmp/* /root/.cache /home/kali/.cache /var/lib/apt/lists/*

WORKDIR /home/kali/workspace
ENTRYPOINT ["entrypoint-hosted.sh"]
