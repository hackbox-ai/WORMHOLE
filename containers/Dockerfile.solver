# Wormhole Solver: overlay on the Cairn worker container to fill PWN and
# internal-network tooling gaps identified by the capability audit.
#
# What this adds (on top of ghcr.io/oritera/cairn-worker-container:latest):
#   PWN:       gdb, strace, ltrace, checksec, ROPgadget, one_gadget, patchelf
#   Network:   chisel (linked to PATH), redis-cli, mongo client
#   Misc:      cmake, go (for compiling PoCs that need building)
#
# Build:
#   docker build -f containers/Dockerfile.solver -t wormhole-solver:latest .
#
# The base image runs as the non-root user ``kali`` (uid 1000). apt installs
# run as root via USER root/USER kali bracketing.

FROM ghcr.io/oritera/cairn-worker-container:latest

USER root

# ---- PWN / binary-analysis tools (apt) ----
# gdb: dynamic debugging (THE critical PWN gap)
# strace/ltrace: syscall/library-call tracing
# patchelf: modify ELF headers (RPATH, interpreter)
# cmake: build PoC exploits that ship CMakeLists
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb \
        gdbserver \
        strace \
        ltrace \
        patchelf \
        cmake \
        redis-tools \
    && rm -rf /var/lib/apt/lists/*

# ---- PWN Python libraries (pip) ----
# checksec.py: binary protection check (NX, PIE, RELRO, canary, Fortify)
# ROPgadget: find ROP gadget sequences in binaries
# one_gadget (ruby gem): find one-shot execve gadgets in libc
# angr: symbolic execution for complex constraints
RUN pip3 install --no-cache-dir --break-system-packages \
        checksec.py \
        ROPgadget \
        angr \
    && gem install one_gadget 2>/dev/null || true

# ---- chisel: link the existing binary to PATH ----
# The base image ships chisel binaries in /usr/share/chisel-common-binaries/
# but they lack execute permission and aren't on PATH. Fix both.
RUN chmod +x /usr/share/chisel-common-binaries/chisel_*_linux_amd64 \
    && ln -sf /usr/share/chisel-common-binaries/chisel_1.11.5_linux_amd64 /usr/local/bin/chisel \
    && chisel version 2>/dev/null || echo "chisel linked"

USER kali

# pip installs user-level binaries to ~/.local/bin (because of --break-system-packages
# landing in the kali user's home). Add it to PATH so checksec, ROPgadget, ropper,
# etc. are discoverable by the worker's shell + claude CLI.
ENV PATH="/home/kali/.local/bin:${PATH}"

# Verify the critical tools are now on PATH (build fails if any is missing).
RUN gdb --version | head -1 \
    && checksec --help 2>&1 | head -1 \
    && ROPgadget --help 2>&1 | head -1 \
    && chisel version 2>&1 | head -1 \
    && strace -V | head -1 \
    && echo "ALL SOLVER TOOLS OK"
