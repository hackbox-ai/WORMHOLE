{
  "name": "wormhole-host",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "WORMHOLE TypeScript API and task host, using Pi for Agent session execution.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "extensions": "tsx scripts/extensions.ts",
    "test:acceptance": "node scripts/acceptance.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/cli": "0.1.22",
    "@xterm/headless": "6.0.0",
    "busboy": "1.6.0",
    "fflate": "^0.8.3",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "node-pty": "1.1.0",
    "nodemailer": "10.5.0",
    "pg": "^8.16.0",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "re2js": "2.10.0",
    "socks-proxy-agent": "10.1.0",
    "tldts": "7.4.18",
    "typebox": "1.3.7",
    "undici": "8.12.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
